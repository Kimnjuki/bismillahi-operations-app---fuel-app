{
  "expo": {
    "name": "Fuelr",
    "slug": "fuelr",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon/screen.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#131313"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fuelr.operations"
    },
    "android": {
      "package": "com.fuelr.operations",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon/screen.png",
        "backgroundColor": "#131313"
      },
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "plugins": [
      "expo-notifications",
      "@react-native-community/datetimepicker"
    ],
    "extra": {
      "eas": {
        "projectId": "your-project-id"
      },
      "supabaseUrl": "https://YOUR_SUPABASE_URL",
      "supabaseAnonKey": "YOUR_SUPABASE_ANON_KEY"
    },
    "sdkVersion": "54.0.0"
  }
}
